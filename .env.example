# ============================================================
# DAINTY — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to GitHub.
# ============================================================

# ── Admin Auth (server-only — NO VITE_ prefix) ─────────────
ADMIN_USERNAME=admin

# REQUIRED — bcrypt hash of your admin password.
# Server exits with code 1 if this is missing (causes 503 on Hostinger).
# Generate with:
#   node -e "import('bcryptjs').then(m=>m.default.hash('YourPassword',12)).then(console.log)"
ADMIN_PASSWORD_HASH=

# REQUIRED — long random secret for JWT signing.
# Server exits with code 1 if this is missing (causes 503 on Hostinger).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ── Relworx Mobile Money ────────────────────────────────────
RELWORX_API_KEY=replace_with_your_relworx_api_key
RELWORX_ACCOUNT_NO=your_relworx_business_account_number
RELWORX_WEBHOOK_KEY=copy_from_relworx_business_account_webhook_settings
# Must match the URL registered in Relworx dashboard exactly:
RELWORX_WEBHOOK_URL=https://daintystudsandchains.com/api/relworx/webhook
# Optional — defaults to Relworx production API
RELWORX_BASE_URL=https://payments.relworx.com/api

# ── Server ──────────────────────────────────────────────────
# PORT is set automatically by Hostinger — do NOT set this in production
# PORT=3000

# ============================================================
# HOSTINGER ENVIRONMENT VARIABLES CHECKLIST
# Set ALL of the following in:
#   Hostinger hPanel -> Node.js -> Your App -> Environment Variables
# ============================================================
# ADMIN_USERNAME          (e.g. admin)
# ADMIN_PASSWORD_HASH     (bcrypt hash  — REQUIRED or server exits with 503)
# ADMIN_SESSION_SECRET    (32+ char hex — REQUIRED or server exits with 503)
# RELWORX_API_KEY
# RELWORX_ACCOUNT_NO
# RELWORX_WEBHOOK_KEY
# RELWORX_WEBHOOK_URL
# RELWORX_BASE_URL
