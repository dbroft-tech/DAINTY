# Server-only Relworx credentials. Never use VITE_ prefixes for secrets.
RELWORX_API_KEY=replace_with_new_rotated_api_key
RELWORX_ACCOUNT_NO=your_relworx_business_account_number
RELWORX_WEBHOOK_KEY=copy_from_relworx_business_account_webhook_settings
# Set after deployment; the exact URL must match the URL registered in Relworx.
# On Hostinger: https://yourdomain.com/api/relworx/webhook
RELWORX_WEBHOOK_URL=https://yourdomain.com/api/relworx/webhook
# Optional; defaults to the Relworx production API.
RELWORX_BASE_URL=https://payments.relworx.com/api
# PORT is assigned automatically by Hostinger — only set API_PORT for local dev
# API_PORT=8787

# Admin portal credentials (set a strong password — defaults to admin123 if not set)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
